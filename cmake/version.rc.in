// Généré par CMake : informations de version du .exe (Propriétés > Détails).
// Volontairement en ASCII pour rester compatible avec windres (MinGW) comme avec rc.exe (MSVC).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName",      "@BLOCS_COMPANY@"
            VALUE "FileDescription",  "Blocs - programmation visuelle par blocs"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "Blocs"
            VALUE "LegalCopyright",   "@BLOCS_COPYRIGHT@"
            VALUE "OriginalFilename", "Blocs.exe"
            VALUE "ProductName",      "Blocs"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040c, 1200
    END
END
